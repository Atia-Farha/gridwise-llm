# ── Required ───────────────────────────────────────────────────────────────
# The only secret the service needs. Never commit the real value.
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Model (optional) ───────────────────────────────────────────────────────
# gpt-5.6-luna is the cost-optimised tier and the default.
# Raise to gpt-5.6-terra if interpretation accuracy needs it.
OPENAI_MODEL=gpt-5.6-luna

# Reasoning budget: none | low | medium | high | xhigh | max
OPENAI_REASONING_EFFORT=low

# ── Latency budget (optional) ──────────────────────────────────────────────
# Kept well under the judge's 30 s per-request limit.
OPENAI_TIMEOUT_SECONDS=12
OPENAI_MAX_ATTEMPTS=3
LLM_DEADLINE_SECONDS=18

# ── Cache (optional) ───────────────────────────────────────────────────────
# Leave empty to use the in-process cache only.
# Docker Compose supplies this automatically.
REDIS_URL=
CACHE_TTL_SECONDS=86400

# ── Server (optional) ──────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
NUMERIC_TOLERANCE=0.01
